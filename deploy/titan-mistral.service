[Unit]
Description=titan-engine mistral.rs model swap: one process, models from deploy/models.toml loaded on demand (default Qwen3.6-35B-A3B tiered + MTP, 64k), web UI at http://127.0.0.1:1234/ui
After=network.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/titan-engine/lib
# per-model TITAN_* settings live in models.toml ([models.titan.env]); env vars here would be the defaults
ExecStart=%h/titan-engine/bin/mistralrs-titan-swap from-config --file %h/titan-engine/deploy/models.toml
# 20G: the 80B / 120B keep their host experts in the GGUF mmap (page cache charged to this cgroup)
MemoryMax=20G
MemorySwapMax=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

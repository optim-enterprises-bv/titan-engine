[Unit]
Description=titan-engine mistral.rs: Qwen3.6-35B-A3B tiered + MTP, chunked prefill (64k context), nvcc-free build, hybrid prefix cache, web UI at http://127.0.0.1:1234/ui
After=network.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/titan-engine/lib
Environment=TITAN_TIERED=1
Environment=TITAN_TIERED_GPU_FRACTION=auto
Environment=TITAN_TIERED_PROFILE=%h/titan-engine/m4/profile-q35.txt
Environment=TITAN_MTP=2
Environment=TITAN_PFS=1
Environment=TITAN_PFS_HEADROOM_MIB=768
Environment=TITAN_DOORBELL=1
Environment=TITAN_CPU_ONEPASS=1
Environment=TITAN_CUDA_GRAPHS=1
Environment=TITAN_CUDA_GRAPHS_RESERVE_MIB=64
Environment=TITAN_TIERED_RESERVE_MIB=1536
ExecStart=%h/titan-engine/bin/mistralrs-titan-pf3 serve --host 127.0.0.1 -p 1234 --paged-attn off --max-seq-len 65536 --format gguf -m %h/ai/models/Qwen3.6-35B-A3B-MTP -f Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
MemoryMax=16G
MemorySwapMax=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
